# Copy to .env (`cp .env.example .env`). Real environment variables take
# precedence over this file.

# 1 = keyless demo: the LLM and all data sources are replaced by deterministic
# fixtures and nothing leaves your machine. Set to 0 for live analysis.
OFFLINE_MODE=1

# --- Required when OFFLINE_MODE=0 -------------------------------------------
# Anthropic API key used by the analyst agents.
ANTHROPIC_API_KEY=
# Comma-separated keys that clients must send in the X-API-Key header of
# POST /research. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# --- Optional ----------------------------------------------------------------
# Claude model used by every analyst.
ANTHROPIC_MODEL=claude-haiku-5-5
# Alpha Vantage key ("demo" only works for a handful of sample tickers).
ALPHA_VANTAGE_API_KEY=demo
# Contact e-mail sent in the User-Agent of SEC EDGAR and news requests.
# SEC asks automated clients to identify themselves — use a real address.
SEC_USER_AGENT_CONTACT=research@example.com
# Max POST /research requests per minute, per API key (or per client IP when
# no keys are configured). Counted in-process, per worker.
RATE_LIMIT_PER_MINUTE=30
